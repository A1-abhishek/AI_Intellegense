<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>DocMind</display-name>

    <!-- SPA Routing: forward all non-file requests to index.html -->
    <filter>
        <filter-name>spa-filter</filter-name>
        <filter-class>com.docmind.SPAFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>spa-filter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Reverse Proxy: forward /api/* to FastAPI backend -->
    <servlet>
        <servlet-name>api-proxy</servlet-name>
        <servlet-class>com.docmind.APIProxyServlet</servlet-class>
        <init-param>
            <param-name>backendUrl</param-name>
            <param-value>http://127.0.0.1:8000</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>api-proxy</servlet-name>
        <url-pattern>/api/*</url-pattern>
    </servlet-mapping>

    <!-- Static resources -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <error-page>
        <error-code>404</error-code>
        <location>/index.html</location>
    </error-page>

    <error-page>
        <error-code>405</error-code>
        <location>/index.html</location>
    </error-page>

</web-app>
